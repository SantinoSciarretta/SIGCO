# ============================================================
#  Variables de entorno del backend
# ============================================================
#
# Este archivo es la PLANTILLA: se copia a `.env` y se completan los valores.
# El `.env` real NO se versiona (está en .gitignore) porque tiene credenciales.
#
# En producción estas mismas variables se cargan en el panel de Railway, no en
# un archivo.

# ---------- Base de datos ----------
# En desarrollo, PostgreSQL local. En producción, la cadena de conexión de
# Supabase (Project Settings > Database > Connection string > JDBC).
DB_URL=jdbc:postgresql://localhost:5432/sigco_dev
DB_USER=postgres
DB_PASSWORD=

# ---------- Seguridad ----------
# Clave con la que se firman los tokens JWT. Mínimo 32 caracteres: HMAC-SHA256
# los exige y con menos la aplicación no arranca.
#
# En producción tiene que ser un valor aleatorio y distinto del de desarrollo.
# Si se filtrara, cualquiera podría fabricar un token válido y entrar como quien
# quisiera. Se puede generar con:
#     openssl rand -base64 48
JWT_SECRETO=clave-de-desarrollo-sigco-2026-no-usar-en-produccion

# ---------- Solo en producción ----------
# Dominio del frontend publicado en Vercel. Es el ÚNICO origen que el backend
# atiende: sin esto, el navegador bloquea todas las llamadas.
# FRONTEND_URL=https://sigco.vercel.app

# Almacenamiento de archivos. En desarrollo queda en "local" (una carpeta de la
# máquina); en producción, Supabase Storage.
# ALMACENAMIENTO_TIPO=supabase
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
