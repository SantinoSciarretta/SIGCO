# ============================================================
#  Plantilla de variables de entorno del backend
#
#  Copiar este archivo como .env y completar los valores.
#  El .env NO se versiona (esta en .gitignore): es el unico lugar
#  donde vive la contrasena de la base de datos.
#
#      Windows:  copy .env.example .env
#      Linux:    cp .env.example .env
# ============================================================

# Conexion a la base de datos de desarrollo (PostgreSQL local).
DB_URL=jdbc:postgresql://localhost:5432/sigco_dev
DB_USER=postgres
DB_PASSWORD=

# En produccion estas mismas variables las define Railway en su panel,
# apuntando a la base de Supabase, y ademas:
#   SPRING_PROFILES_ACTIVE=prod
#   FRONTEND_URL=https://<dominio-del-frontend-en-vercel>
