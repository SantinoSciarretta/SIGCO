<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		El "parent" de Spring Boot fija las versiones de todas las librerias que
		usamos. Por eso las dependencias de abajo no llevan numero de version:
		la hereda de aca. Asi se evita combinar versiones incompatibles entre si.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.sigco</groupId>
	<artifactId>sigco-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>sigco-backend</name>
	<description>SIGCO - Sistema Integral de Gestion de Obras</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<!--
			API REST sobre HTTP. Incluye el servidor Tomcat embebido, por eso la
			aplicacion se ejecuta sola sin instalar un servidor aparte.
			En Spring Boot 4 este starter se llama "webmvc" (en la 3.x era "web").
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			Persistencia: Hibernate como implementacion de JPA, mas los
			repositorios de Spring Data que evitan escribir el CRUD a mano.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
			Bean Validation: las anotaciones @NotBlank, @Size, @Positive que
			hacen cumplir en el servidor las reglas del informe. Esta es la
			validacion que manda; la del frontend es solo para dar respuesta
			inmediata al usuario.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Flyway: ejecuta las migraciones SQL versionadas de
			src/main/resources/db/migration al arrancar la aplicacion.
			Desde Flyway 10 el soporte de cada motor va en un artefacto aparte,
			por eso ademas del starter hace falta flyway-database-postgresql.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
			Driver de PostgreSQL. Es "runtime" porque el codigo nunca lo importa:
			solo hace falta que este disponible cuando la aplicacion se ejecuta.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Dependencias de test (JUnit 5, AssertJ, Mockito y utilidades de
			Spring). En Spring Boot 4 estan divididas por area en lugar del unico
			spring-boot-starter-test de la 3.x.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			OpenPDF: genera el PDF del presupuesto que se le envia al cliente.
			Entra ahora porque es el modulo que la necesita.

			Lleva version explicita, a diferencia del resto: el parent de Spring
			Boot no administra esta libreria, asi que no hay una version que
			heredar.

			Se eligio OpenPDF y no iText por licencia: iText paso a AGPL, que
			obliga a publicar el codigo de cualquier sistema que la use. OpenPDF
			es su bifurcacion bajo LGPL/MPL, sin esa restriccion.

			NO ACTUALIZAR a 2.1.0 o posterior sin subir antes la version de Java.
			Desde la 2.1.0 la libreria se compila para Java 21, y este proyecto
			usa Java 17 (el que declara la Propuesta Tecnica). Con una version
			mas nueva el proyecto COMPILA pero falla al arrancar, con
			"UnsupportedClassVersionError: class file version 65.0, this version
			of the Java Runtime only recognizes class file versions up to 61.0".
			La 2.0.5 es la ultima compilada para Java 17.
		-->
		<dependency>
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>2.0.5</version>
		</dependency>

		<!--
			PENDIENTE (se agrega cuando entra el modulo que la necesita):
			  - spring-boot-starter-security  -> modulo 14 (Accesos)
		-->

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
