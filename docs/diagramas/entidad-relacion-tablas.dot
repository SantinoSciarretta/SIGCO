  /* Claves foraneas: de la columna FK a la PK que referencia. */
  cotizacion:id_material -> material:id_material;
  cotizacion:id_proveedor -> proveedor:id_proveedor;
  cuota:id_obra -> obra:id_obra;
  gasto:id_obra -> obra:id_obra;
  gasto:id_operario -> operario:id_operario;
  gasto:id_pedido -> pedido:id_pedido;
  gasto:id_rubro -> rubro:id_rubro;
  gasto:id_subrubro -> subrubro:id_subrubro;
  gasto:id_usuario_registro -> usuario:id_usuario;
  hito:id_obra -> obra:id_obra;
  hito:id_usuario_completa -> usuario:id_usuario;
  imagen_portfolio:id_publicacion -> publicacion_portfolio:id_publicacion;
  inasistencia:id_obra -> obra:id_obra;
  inasistencia:id_operario -> operario:id_operario;
  inasistencia:id_usuario_registro -> usuario:id_usuario;
  item_presupuesto:id_material -> material:id_material;
  item_presupuesto:id_presupuesto -> presupuesto:id_presupuesto;
  item_presupuesto:id_rubro -> rubro:id_rubro;
  item_presupuesto:id_subrubro -> subrubro:id_subrubro;
  material:id_rubro -> rubro:id_rubro;
  obra:id_cliente -> cliente:id_cliente;
