# ============================================================
#  Frontend en produccion (Vercel)
# ============================================================
#
# Direccion del backend publicado en Railway. En desarrollo esto vale "/api"
# —el proxy de Vite— y aca la URL completa, porque el frontend y el backend
# estan en dominios distintos.
#
# El valor real NO va en este archivo: se carga en el panel de Vercel, en
# Settings > Environment Variables, con este mismo nombre. Asi la direccion se
# puede cambiar sin tocar el repositorio.
#
# Vite reemplaza estas variables al COMPILAR, no al ejecutar: un cambio en el
# panel necesita un despliegue nuevo para tener efecto.
VITE_API_URL=https://CAMBIAR-POR-EL-BACKEND.up.railway.app/api
